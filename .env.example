# Backend API & WebSocket URLs
# In production, set this to your deployed Railway backend URL (e.g. https://devcollab-backend-production.up.railway.app)
REACT_APP_API_URL=https://your-backend.up.railway.app
# Optional: WS_URL is automatically derived from REACT_APP_API_URL if omitted
REACT_APP_WS_URL=https://your-backend.up.railway.app/ws
